#!/bin/bash
#SBATCH --job-name=v7_adamw_fulldecay
#SBATCH --partition=full
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=logs/retry_eval_training_%j.log
#SBATCH --error=logs/retry_eval_training_%j.err
set -euo pipefail
cd /home/cip/2024/hy47pini/watwa-nn-blo/
mkdir -p logs

/home/cip/2024/hy47pini/watwa-nn-blo/.venv/bin/python3 -u -m blo.scripts.03_train_nn \
  --problem watwa_v7 \
  --use_context 1 \
  --context_hidden_dim 32 \
  --batch_size 512 \
  --lr 0.001 \
  --n_epochs 1000 \
  --metric top1_acc \
  --weight_decay 1e-6 \
  --ranking_loss_weight 0.0 \
  --optimizer AdamW

# --- Sofortige, eindeutig benannte Sicherung, damit kein künftiger Lauf
#     denselben "kurzen Pfad" überschreiben kann ---
TS=$(date +%Y%m%d_%H%M)
cp data/nn_inst_encoder_both_nsi-498_nspi-100000_s-7.pt \
   data/nn_inst_encoder_both_nsi-498_nspi-100000_s-7_FULLDECAY_VERIFIED_${TS}.pt
cp data/nn_res_inst_encoder_both_nsi-498_nspi-100000_s-7.pkl \
   data/nn_res_inst_encoder_both_nsi-498_nspi-100000_s-7_FULLDECAY_VERIFIED_${TS}.pkl

echo "Backed up model + results with timestamp ${TS}"
